<plist version="1.0">
<dict>
	<key>musicLibrary.search.albumsCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@albums@</string>
		<key>albums</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d álbum</string>
			<key>other</key>
			<string>%d álbuns</string>
		</dict>
	</dict>
</dict>
</plist>
